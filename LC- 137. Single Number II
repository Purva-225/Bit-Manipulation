//Brute approach by unordered map : Tc: O(N log M) + O(m) ⁛ M = size of array. 
//Sc: O(M). 

class Solution {
public:
    int singleNumber(vector<int>& nums){
       unordered_map<int,int> mpp; 
       for(int i = 0; i<nums.size(); i++){
        mpp[nums[i]]++; 
       }
       for(auto it: mpp){
        if(it.second == 1){
            return it.first;
        }
       }
       return -1; 
    }
};

// Better: using Bit manipulation, Tc: O(N * 32), Sc: O(1)

class Solution {
public:
    int singleNumber(vector<int>& nums){
        int n = nums.size();
      int ans = 0; 
      for(int Bitidx = 0; Bitidx<32; Bitidx++){
        int cnt = 0; 
        for(int i = 0; i<n; i++){
            if(nums[i] & (1 << Bitidx))
                 cnt++;
        }
         if(cnt % 3 == 1){
                ans = ans | (1<< Bitidx);
            }
      }
      return ans; 
    }
};

// Optimal: Tc: O(n log n ) + n/3; , Sc: O(1) 

class Solution {
public:
    int singleNumber(vector<int>& nums){
        sort(nums.begin(), nums.end()); 
        int n = nums.size(); 

        for(int i = 0; i<n; i+= 3){
            if(i + 2 >= n ||nums[i] != nums[i+2]){
                return nums[i]; 
            }
        }
        return -1; 
    }
};

// More Optimized One: Tc: O(n), Sc: O(1) 

class Solution {
public:
    int singleNumber(vector<int>& nums){
        int Ones = 0; 
        int Twos = 0; 
        for(int i = 0; i<nums.size(); i++){
            Ones = (Ones ^ nums[i]) & ~ Twos; 
            Twos = (Twos ^ nums[i]) & ~ Ones; 
        }
        return Ones; 
    }
};
